# Docker ignore file for ModResorts Java application
# Exclude build artifacts and unnecessary files from Docker context

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Maven wrapper files (CRITICAL: Never use wrapper in Docker)
mvnw
mvnw.cmd
.mvn/

# Gradle build artifacts
build/
.gradle/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Gradle wrapper files (CRITICAL: Never use wrapper in Docker)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git files
.git/
.gitignore
.gitattributes

# Documentation and non-essential files
*.md
README*
LICENSE
CONTRIBUTING*
CODEOWNERS
docs/
migration-bundle/

# Test files
src/test/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.cache
